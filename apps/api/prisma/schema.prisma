generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  QUALITY_MANAGER
  QUALITY_ENGINEER
  PRODUCTION
  MAINTENANCE
  AUDITOR
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  VERIFIED
  CLOSED
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  VERIFIED
}

enum ActionType {
  CORRECTIVE
  PREVENTIVE
  CONTAINMENT
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
  CONDITIONAL
}

model Tenant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  users       User[]
  lines       ProductionLine[]
  products    Product[]
  defects     Defect[]
  actions     CapaAction[]
  inspections Inspection[]
  productionRecords ProductionRecord[]
  equipment   Equipment[]
  maintenanceEvents MaintenanceEvent[]
  audits      QualityAudit[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model User {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(QUALITY_ENGINEER)
  defects      Defect[]    @relation("DefectOwner")
  actions      CapaAction[] @relation("ActionOwner")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([tenantId])
}

model ProductionLine {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  active    Boolean   @default(true)
  defects   Defect[]
  inspections Inspection[]
  productionRecords ProductionRecord[]
  equipment Equipment[]
  @@unique([tenantId, code])
}

model Product {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sku       String
  defects   Defect[]
  inspections Inspection[]
  productionRecords ProductionRecord[]
  @@unique([tenantId, sku])
}

model Defect {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference       String
  title           String
  description     String?
  severity        Severity
  status          DefectStatus @default(OPEN)
  lineId          String?
  line            ProductionLine? @relation(fields: [lineId], references: [id])
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id])
  ownerId         String?
  owner           User?        @relation("DefectOwner", fields: [ownerId], references: [id])
  batchNumber     String?
  quantityChecked Int          @default(0)
  quantityDefective Int        @default(0)
  productionLoss  Decimal      @default(0) @db.Decimal(12, 2)
  detectedAt      DateTime     @default(now())
  dueAt           DateTime?
  rootCause       RootCause?
  actions         CapaAction[]
  inspections     Inspection[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, detectedAt])
}

model RootCause {
  id          String   @id @default(cuid())
  defectId    String   @unique
  defect      Defect   @relation(fields: [defectId], references: [id], onDelete: Cascade)
  method      String   @default("5_WHYS")
  why1        String?
  why2        String?
  why3        String?
  why4        String?
  why5        String?
  verifiedCause String?
  evidence    Json?
  aiSuggestions Json?
  fishbone    Json?
  pareto      Json?
  fmea        Json?
  eightD      Json?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CapaAction {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defectId    String?
  defect      Defect?      @relation(fields: [defectId], references: [id])
  ownerId     String?
  owner       User?        @relation("ActionOwner", fields: [ownerId], references: [id])
  title       String
  description String?
  type        ActionType   @default(CORRECTIVE)
  status      ActionStatus @default(OPEN)
  dueAt       DateTime?
  completedAt DateTime?
  effectivenessNotes String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([tenantId, status])
}

model Inspection {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defectId    String?
  defect      Defect?          @relation(fields: [defectId], references: [id])
  lineId      String?
  line        ProductionLine?  @relation(fields: [lineId], references: [id])
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id])
  title       String
  stage       String
  batchNumber String?
  result      InspectionResult @default(PENDING)
  checked     Int              @default(0)
  failed      Int              @default(0)
  inspectorName String?
  performedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([tenantId, performedAt])
}

model ProductionRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineId      String
  line        ProductionLine @relation(fields: [lineId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  recordDate  DateTime
  shift       String
  plannedQty  Int
  producedQty Int
  rejectedQty Int
  downtimeMinutes Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, lineId, recordDate, shift])
  @@index([tenantId, recordDate])
}

model Equipment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineId      String?
  line        ProductionLine? @relation(fields: [lineId], references: [id])
  code        String
  name        String
  type        String
  status      String   @default("RUNNING")
  healthScore Int      @default(100)
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?
  events      MaintenanceEvent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model MaintenanceEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type        String
  description String
  status      String   @default("OPEN")
  downtimeMinutes Int  @default(0)
  startedAt   DateTime @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([tenantId, startedAt])
}

model QualityAudit {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  standard    String
  status      String   @default("PLANNED")
  auditDate   DateTime
  ownerName   String?
  score       Int?
  findings    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, auditDate])
}
