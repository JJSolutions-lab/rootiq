# PostgreSQL (Docker Compose defaults)
POSTGRES_DB=rootiq
POSTGRES_USER=rootiq
POSTGRES_PASSWORD=rootiq_dev_password
DATABASE_URL=postgresql://rootiq:rootiq_dev_password@localhost:5433/rootiq?schema=public

# cPanel example (replace every placeholder; URL-encode special password characters):
# DATABASE_URL=postgresql://CPANEL_DB_USER:DB_PASSWORD@localhost:5432/CPANEL_DB_NAME?schema=public
# For a remote PostgreSQL host that requires TLS, append: &sslmode=require

# API and authentication
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional OpenAI-compatible LLM provider
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Python vision service
VISION_API_URL=http://localhost:8000
